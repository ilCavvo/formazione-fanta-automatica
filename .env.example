# Copia in .env per i run locali. NON committare mai il .env reale.
# In GitHub Actions questi valori arrivano dai Secrets con gli stessi nomi.

# Credenziali fantacalcio.it (le stesse che usi su leghe.fantacalcio.it)
FANTACALCIO_USERNAME=
FANTACALCIO_PASSWORD=

# Slug della lega, cioe' il pezzo di URL: https://leghe.fantacalcio.it/<SLUG>/
FANTACALCIO_LEAGUE_SLUG=

# Bot Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Override opzionale del DRY_RUN definito in config/config.yaml ("true"/"false")
# DRY_RUN=true
